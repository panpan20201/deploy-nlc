# Образец настроек. Скопируйте файл в .env и заполните своими значениями:
#     copy .env.example .env
# Файл .env содержит токены и пароли: не публикуйте его и не пересылайте
# через чаты и почту. В репозиторий он не попадает (.gitignore).
#
# Пустое значение означает «не задано»: бот при старте пишет в лог, какая
# функция без этой строки работать не будет.

# --- Telegram-бот ---
# Токен от @BotFather. Обязателен: без него бот не запустится.
BOT_TOKEN=

# Telegram chat_id администратора: получает оповещения о поломках
# (планшет отвалился, Appium закрыт, заканчивается дневной лимит
# Carmoodo) и копии отчётов. Узнать свой id можно у бота @userinfobot.
# Если пусто — оповещений не будет.
ADMIN_CHAT_ID=

# --- PARTSNUMBER (веб-клиент VMware Horizon) ---
PARTSNUMBER_LOGIN_URL=https://login.partsnumber.com/
PARTSNUMBER_USERNAME=
PARTSNUMBER_PASSWORD=
# Необязательно: VIN для ручного тестового запуска partsnumber_date.py
PARTSNUMBER_TEST_VIN=
# 1 — подробные логи распознавания экрана, 0 — обычный режим
PARTSNUMBER_DEBUG=0

# --- Appium / устройство (HeyDealer, Carmoodo) ---
# Адрес Appium-сервера. Бот, Appium и планшет работают на одном
# компьютере, поэтому значение по умолчанию подходит.
APPIUM_SERVER_URL=http://127.0.0.1:4723

# Серийный номер (udid) планшета — показывает команда `adb devices`.
# Рекомендуется заполнить: без него устройство выбирается по имени, и при
# подключении второго устройства бот может начать управлять не тем.
ANDROID_UDID=

# Используется, только если ANDROID_UDID не задан.
ANDROID_DEVICE_NAME=emulator-5554

# Необязательно: папка Android SDK. Если задана, adb берётся из
# <папка>\platform-tools, иначе — из PATH.
# ANDROID_HOME=

# --- Carmoodo (вход в приложение) ---
# Нужны, чтобы бот мог сам войти заново, если приложение вышло из
# аккаунта. Если пусто — бот не входит сам и пишет в лог, что нужен
# ручной вход.
CARMOODO_USERNAME=
CARMOODO_PASSWORD=

# --- Перевод терминов HeyDealer (DeepL) ---
# Незнакомые термины переводятся через DeepL и запоминаются в
# translation_cache.json. Бесплатный ключ (500 000 символов в месяц):
# https://www.deepl.com/pro-api
# Если пусто — незнакомые термины показываются как есть, с пометкой "[?]".
DEEPL_API_KEY=

# --- Хранение результатов проверок ---
# Сколько дней история ремонта считается свежей. VIN и детали хранятся
# бессрочно — они не меняются. Чем больше срок, тем больше повторных
# запросов отвечается из базы, не расходуя дневные лимиты сервисов
# (HeyDealer — 10 проверок в сутки, Carmoodo — 30).
REPAIR_HISTORY_TTL_DAYS=30

# --- Сброс рекламного ID (снятие дневного лимита HeyDealer) ---
# Предохранитель от зацикливания автоматики, а не ограничение сервиса.
# Ориентир: нужное число проверок в сутки разделить на 10.
MAX_ADS_RESETS_PER_DAY=4

# Минимальная пауза между сбросами, в секундах. 0 отключает паузу — только
# для отладки; в рабочем режиме оставьте 300.
MIN_SECONDS_BETWEEN_ADS_RESETS=300

# --- Диагностика ---
# 1 — при создании сессии HeyDealer перебрать настройки uiautomator2 и
# записать результат в лог (около 20 секунд). В обычной работе 0.
HEYDEALER_TREE_PROBE=0
